    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv-cli": "^11.1.0",
    "prisma": "^7.10.1",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
