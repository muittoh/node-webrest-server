  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "prisma generate && rimraf ./dist && tsc",
    "start": "node dist/app.js",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:migrate:test": "dotenv -e .env.test -- npx prisma migrate deploy",
    "test": "npm run prisma:migrate:test && vitest run",
    "test:watch": "npm run prisma:migrate:test && vitest",
    "test:coverage": "npm run prisma:migrate:test && vitest run --coverage",
    "typecheck:test": "tsc --project tsconfig.test.json"
  },
